+        "signal": "add a 2-bit level (MLX supports it), raise env.n_fields to 3, or test longer horizons",
+        "cache": "the chat template is not append-friendly: send the output of this script",
+        "cost": "lower atlas.n_tasks / n_samples / max_turns, drop a bit-width, or cap agent.max_think_tokens",
+    }
+    for name, ok, msg in checks:
