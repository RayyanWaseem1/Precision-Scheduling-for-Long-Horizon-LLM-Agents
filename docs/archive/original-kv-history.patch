+++ b/scripts/phase1_gate.py
@@ -0,0 +1,256 @@
+"""Phase 1 gate: is this model + config ready for the Phase 2 sensitivity atlas?
+
+Runs uniform-precision episodes at each requested bit-width and horizon on task seeds
+disjoint from the atlas and the horizon sweep, then checks five things:
+
+  1. format     the model emits parseable tool calls at the reference precision
+  2. reliable   reference-precision success at the gate horizon meets the bar
+  3. signal     the lowest bit-width has a measurably higher per-turn failure rate
+  4. cache      history is append-only: no assistant text is re-prefilled
+  5. cost       what the atlas in the config will take on this machine
+
+Usage:
+  python scripts/phase1_gate.py -c configs/mac_pilot.yaml --quick
+  python scripts/phase1_gate.py -c configs/mac_pilot.yaml --out runs/gate_mac_qwen3_1p7b.json
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import statistics
+import sys
+import time
+from collections import Counter, defaultdict
+from dataclasses import replace
+from pathlib import Path
+
+from hazprec.agent.harness import AgentHarness
+from hazprec.config import env_config, harness_kwargs, load_config
+from hazprec.envs.horizongym import HorizonGymEnv
+from hazprec.eval.stats import wilson_interval
+from hazprec.quant.backends import make_backend
+from hazprec.scheduler import UniformPolicy
+from hazprec.sensitivity.replay import PROBES
+
+
+def failure_kind(reason: str) -> str:
+    if reason.startswith("could not parse"):
+        return "unparseable"
+    if reason.startswith("expected tool"):
+        return "wrong_tool"
+    if reason.startswith("missing argument"):
+        return "missing:" + reason.split("'")[1]
+    if reason.startswith("wrong value"):
+        return "wrong:" + reason.split("'")[1]
+    return reason
+
+
+def run_episode(harness: AgentHarness, env: HorizonGymEnv, seed: int) -> dict:
+    """``AgentHarness.run_episode``, unrolled so we can see each observation and time it."""
+    be = harness.backend
+    env.reset(seed)
+    be.reset(seed)
+    be.bind_env(env)
+    harness.policy.begin_episode()
+    harness.hinter = harness.hinter_factory() if harness.hinter_factory else None
+    stats0 = dict(getattr(be, "stats", {}))
+    msgs = env.messages()
+    cfg = env.config
+    limit = cfg.horizon * (1 + (cfg.max_retries if cfg.error_mode == "recoverable" else 0)) + 2
+    turns, read_overhead = [], []
+    t0 = time.perf_counter()
+    while not env.state.done and len(turns) < limit:
+        obs = msgs[-1]["content"] if len(turns) > 0 else None
+        rec = harness.run_turn(env, msgs, len(turns))
+        if obs is not None and hasattr(be, "_encode"):
+            read_overhead.append(rec.segments[0].tokens - len(be._encode(obs)))
+        turns.append(rec)
+    secs = time.perf_counter() - t0
+    stats1 = dict(getattr(be, "stats", {}))
+    prefill = sum(s.tokens for t in turns for s in t.segments if s.phase.value in ("system", "read"))
+    decode = sum(s.tokens for t in turns for s in t.segments if s.phase.value in ("think", "act", "stop"))
+    fail = next((t for t in turns if not t.correct), None)
+    return {
+        "seed": seed,
+        "success": env.state.success,
+        "turns": len(turns),
+        "correct_turns": sum(t.correct for t in turns),
+        "failure": None if fail is None else failure_kind(fail.reason),
+        "failure_phase": None if fail is None else fail.expected_phase.value,
+        "parse_failures": sum(t.call is None for t in turns),
+        "prefill_tokens": prefill,
+        "decode_tokens": decode,
+        "seconds": secs,
+        "full_renders": stats1.get("full", 0) - stats0.get("full", 0),
+        "read_overhead": read_overhead,
+        "example_call": next((t.call.to_json() for t in turns if t.call is not None), None),
+    }
+
+
+def summarize(eps: list[dict]) -> dict:
+    n = len(eps)
+    succ = sum(e["success"] for e in eps)
+    turns = sum(e["turns"] for e in eps)
+    fails = sum(e["turns"] - e["correct_turns"] for e in eps)
+    lo, hi = wilson_interval(succ, n)
+    hlo, hhi = wilson_interval(fails, turns)
+    secs = sum(e["seconds"] for e in eps)
+    return {
+        "episodes": n,
+        "success": succ / n,
+        "success_ci95": [lo, hi],
+        "turns": turns,
+        "turn_failures": fails,
+        "turn_hazard": fails / max(turns, 1),
+        "turn_hazard_ci95": [hlo, hhi],
+        "parse_rate": 1 - sum(e["parse_failures"] for e in eps) / max(turns, 1),
+        "failure_kinds": dict(Counter(e["failure"] for e in eps if e["failure"])),
+        "sec_per_turn": secs / max(turns, 1),
+        "decode_tok_per_sec": sum(e["decode_tokens"] for e in eps) / max(secs, 1e-9),
+        "tokens_per_turn": (sum(e["prefill_tokens"] + e["decode_tokens"] for e in eps)) / max(turns, 1),
+    }
+
+
+def atlas_cost(cfg: dict, ref_sec_per_turn: float, ref_turns_per_task: float) -> dict:
+    """Wall-clock estimate for ``hazprec atlas`` with this config, from measured speed."""
+    at, be = cfg["atlas"], cfg["backend"]
+    levels = list(be["levels"])
+    settings = 1 + len(PROBES) * (len(levels) - 1)  # one ref setting + every probe x non-ref level
+    horizon = 2 * int(cfg["env"]["n_hops"]) + 1
+    replayed = min(ref_turns_per_task, at.get("max_turns") or horizon)
+    regens = replayed * settings * int(at["n_samples"])
+    per_task = (ref_turns_per_task + regens) * ref_sec_per_turn
+    total = per_task * int(at["n_tasks"])
+    return {
+        "settings_per_turn": settings,
+        "replayed_turns_per_task": replayed,
+        "turn_regenerations_per_task": regens,
+        "minutes_per_task": per_task / 60,
+        "hours_total": total / 3600,
+        "n_tasks": int(at["n_tasks"]),
+        "n_samples": int(at["n_samples"]),
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("-c", "--config", required=True)
+    ap.add_argument("--set", dest="overrides", action="append", default=[], metavar="KEY=VALUE")
+    ap.add_argument("--bits", type=int, nargs="*", help="bit-widths to test (default: reference and lowest level)")
+    ap.add_argument("--hops", type=int, nargs="*", default=[1, 5], help="horizons in hops (default: 1 5)")
+    ap.add_argument("--gate-hops", type=int, default=5, help="horizon the reliability bar applies to")
+    ap.add_argument("--n", type=int, default=30, help="episodes per (bits, hops)")
+    ap.add_argument("--quick", action="store_true", help="10 episodes at 1 hop: a 2-5 minute first look")
+    ap.add_argument("--min-ref-success", type=float, default=0.8)
+    ap.add_argument("--min-parse-rate", type=float, default=0.98)
+    ap.add_argument("--max-read-overhead", type=int, default=48, help="template tokens around an observation")
+    ap.add_argument("--atlas-budget-hours", type=float, default=24.0)
+    ap.add_argument("--seed0", type=int, default=200_000, help="disjoint from atlas (0..) and horizon (100000..) seeds")
+    ap.add_argument("--out", default=None, help="write the full report as JSON")
+    a = ap.parse_args(argv)
+    if a.quick:
+        a.n, a.hops, a.gate_hops = 10, [1], 1
+
+    cfg = load_config(a.config, a.overrides)
+    levels = list(cfg["backend"]["levels"])
+    ref = int(cfg["backend"]["ref_bits"])
+    bits_list = a.bits or sorted({ref, min(levels)}, reverse=True)
+    print(f"[gate] loading backend {cfg['backend']['kind']} levels={levels} ref={ref}", flush=True)
+    t_load = time.perf_counter()
+    be = make_backend(cfg["backend"], cfg["seed"])
+    print(f"[gate] loaded in {time.perf_counter() - t_load:.0f}s", flush=True)
+
+    base_env = env_config(cfg)
+    results: dict[tuple[int, int], list[dict]] = defaultdict(list)
+    for hops in a.hops:
+        env = HorizonGymEnv(replace(base_env, n_hops=hops))
+        for b in bits_list:
+            h = AgentHarness(be, UniformPolicy(b), think=cfg["agent"]["think"], **harness_kwargs(cfg))
+            for i in range(a.n):
+                results[(b, hops)].append(run_episode(h, env, a.seed0 + 1000 * hops + i))
+            s = summarize(results[(b, hops)])
+            print(f"[gate] {b:>2} bits, {hops:>2} hops: success {s['success']:.2f} "
+                  f"({s['sec_per_turn']:.1f}s/turn, {s['decode_tok_per_sec']:.0f} decode tok/s)", flush=True)
+
+    # ---- report -------------------------------------------------------------------
+    print("\n bits  hops  success [95% CI]     turn hazard [95% CI]   parse   s/turn  failures")
+    table = {}
+    for (b, hops), eps in sorted(results.items(), key=lambda kv: (kv[0][1], -kv[0][0])):
+        s = summarize(eps)
+        table[f"{b}b_{hops}h"] = s
+        kinds = ", ".join(f"{k}={v}" for k, v in sorted(s["failure_kinds"].items(), key=lambda kv: -kv[1])) or "-"
+        print(f"{b:>5} {hops:>5}  {s['success']:.2f} [{s['success_ci95'][0]:.2f},{s['success_ci95'][1]:.2f}]"
+              f"     {s['turn_hazard']:.3f} [{s['turn_hazard_ci95'][0]:.3f},{s['turn_hazard_ci95'][1]:.3f}]"
+              f"   {s['parse_rate']:.3f}  {s['sec_per_turn']:6.1f}  {kinds}")
+
+    ref_eps = [e for (b, _), eps in results.items() if b == ref for e in eps]
+    low = min(bits_list)
+    low_eps = [e for (b, _), eps in results.items() if b == low for e in eps]
+    ref_s = summarize(ref_eps)
+    checks = []
+
+    checks.append(("format", ref_s["parse_rate"] >= a.min_parse_rate,
+                   f"parse rate at {ref} bits = {ref_s['parse_rate']:.3f} (need >= {a.min_parse_rate})"))
+
+    gate = results.get((ref, a.gate_hops))
+    if gate:
+        g = summarize(gate)
+        checks.append(("reliable", g["success"] >= a.min_ref_success,
+                       f"{ref}-bit success at {a.gate_hops} hops = {g['success']:.2f} "
