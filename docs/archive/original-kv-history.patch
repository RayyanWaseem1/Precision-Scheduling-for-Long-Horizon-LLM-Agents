+        if not ok:
+            print(f"           -> {hints[name]}")
+    example = next((e["example_call"] for e in ref_eps if e["example_call"]), None)
+    if example:
+        print(f"\nexample tool call at {ref} bits: {example}")
+
+    if a.out:
+        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+        Path(a.out).write_text(json.dumps({
