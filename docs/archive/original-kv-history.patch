+            "atlas_cost": cost, "episodes": {f"{b}b_{h}h": eps for (b, h), eps in results.items()},
+        }, indent=2, default=str))
+        print(f"report written to {a.out}")
+    return 0 if all(ok for _, ok, _ in checks) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
